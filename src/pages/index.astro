---
import Base from '../layouts/Base.astro';
import M from '../components/M.astro';
import { SITE, PHOTO, getRecentPosts, getThreads, postUrl, threadIdOf, formatDate, isoDate, publishedOf } from '../lib/site';
const latest = (await getRecentPosts()).slice(0, 10);
const threadTitle = new Map((await getThreads()).map(({ thread }) => [thread.id, thread.data.title]));
---
<Base section="main">
  <section class="who">
    <img class="photo" src={PHOTO.src} width="112" height="112" alt="" />
    <h1>{SITE.name}</h1>
    <p class="line">{SITE.line}</p>
  </section>
  <section class="bio">
    {SITE.bio.map((p) => <p>{p}</p>)}
  </section>
  <section class="latest" aria-labelledby="latest-h">
    <h2 id="latest-h">Latest posts</h2>
    <ul class="rows">
      {latest.map((post) => (
        <li>
          <span class="entry">
            <a href={postUrl(post)}><M text={post.data.title} /></a>
            <span class="in"><M text={threadTitle.get(threadIdOf(post)) ?? ''} /></span>
          </span>{' '}
          <time class="date" datetime={isoDate(publishedOf(post))}>{formatDate(publishedOf(post))}</time>
        </li>
      ))}
    </ul>
  </section>
  <section class="contacts" aria-labelledby="contacts-h">
    <h2 id="contacts-h">Contacts</h2>
    <ul class="rows">
      {SITE.contacts.map((c) => (
        <li><span class="label">{c.label}</span>{' '}<a href={c.href}>{c.text}</a></li>
      ))}
    </ul>
  </section>
</Base>
