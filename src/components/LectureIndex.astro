---
// The index of a thread of lectures: a button fixed in the left margin, so
// that it can be reached from anywhere in a post, opens a panel above the
// blurred page with every lecture of the thread and its numbered statements.
// The list itself comes from statements.json (src/lib/statements.ts) on first
// use. The script is src/scripts/lecture-index.js.
import M from './M.astro';

interface Props { thread: string; title: string; lecture?: number }
const { thread, title, lecture } = Astro.props;
---
<button class="index-button" type="button" aria-haspopup="dialog" aria-controls="lecture-index" aria-expanded="false" data-src={`/threads/${thread}/statements.json`} data-lecture={lecture}>Index</button>
<div class="index-overlay" id="lecture-index" role="dialog" aria-modal="true" aria-labelledby="lecture-index-title" hidden>
  <div class="index-panel">
    <header class="index-head">
      <h2 id="lecture-index-title">Index</h2>
      <p class="index-thread"><M text={title} /></p>
      <button class="index-close" type="button" aria-label="Close the index" title="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>
    <div class="index-body" tabindex="-1"></div>
  </div>
</div>
<script>
  import '../scripts/lecture-index.js';
</script>
