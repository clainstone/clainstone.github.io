---
/** An image with a caption. `src` is an imported image or a URL. */
import { Image } from 'astro:assets';
interface Props { src: ImageMetadata | string; alt: string; caption?: string; width?: number; }
const { src, alt, caption, width } = Astro.props;
---
<figure class="anim-figure">
  {typeof src === 'string'
    ? <img src={src} alt={alt} width={width} loading="lazy" />
    : <Image src={src} alt={alt} width={width ?? src.width} loading="lazy" />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
