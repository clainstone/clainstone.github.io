---
/**
 * The prompt of the run, as every agent received it. prompt.txt is a byte
 * copy of the run's prompts/brief.txt, imported raw, so that the MDX pipeline
 * (lists, smart quotes, dashes) never touches it. Its long lines wrap instead
 * of scrolling sideways, as a code block of the site otherwise would.
 */
import prompt from './prompt.txt?raw';
---
<pre class="prompt"><code>{prompt}</code></pre>

<style>
  .prompt { white-space: pre-wrap; }
</style>
