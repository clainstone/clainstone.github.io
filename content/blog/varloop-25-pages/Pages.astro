---
/**
 * The table of one N's five pages. Each table would otherwise size its own
 * columns, so the five tables of the post would not line up; fixed widths
 * give them one grid, wide enough that no title wraps.
 */
---
<div class="pages"><slot /></div>

<style>
  .pages :global(table) { table-layout: fixed; }
  .pages :global(th:nth-child(1)) { width: 3.5rem; }
  .pages :global(th:nth-child(2)) { width: 13rem; }
  .pages :global(th:nth-child(3)),
  .pages :global(th:nth-child(4)),
  .pages :global(th:nth-child(5)) { width: 5.25rem; }
  .pages :global(th:nth-child(6)) { width: 3.75rem; }
</style>
